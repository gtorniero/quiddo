{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiddo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // banco das compras. Na primeira publicação a Cloudflare cria o banco "quiddo" sozinha.
  "d1_databases": [{ "binding": "DB", "database_name": "quiddo" }],
  // cobrança: "simulacao" (para todos, com Pix de mentira e sem cartão), "teste" (só com ?teste_cobranca=1),
  // "ligada" (de verdade, para todos) ou "desligada". Preços (PRECO_MENSAL, PRECO_SEMANA; padrão 25.99 e 15.99)
  // e segredos (MP_TOKEN, STRIPE_KEY) ficam só no painel da Cloudflare.
  "vars": { "COBRANCA": "simulacao" },
  // mantém variáveis criadas no painel
  "keep_vars": true,
  "observability": { "enabled": true }
}
