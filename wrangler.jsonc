{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiddo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // banco das compras. Na primeira publicação a Cloudflare cria o banco "quiddo" sozinha.
  "d1_databases": [{ "binding": "DB", "database_name": "quiddo" }, {"binding":"PROMOS","database_name":"btw-promocoes","database_id":"84c12b97-d46d-4ba6-abe5-f6e8e7bcf84c"}],
  // cobrança: "simulacao" (para todos, com Pix de mentira e sem cartão), "teste" (só com ?teste_cobranca=1),
  // "ligada" (de verdade, para todos) ou "desligada". Preços (PRECO_MENSAL, PRECO_SEMANA; padrão 15.99 e 12.99; anual 156.00 e oferta 9.99)
  // e segredos (MP_TOKEN, STRIPE_KEY) ficam só no painel da Cloudflare.
  // ids dos preços de produção no Stripe (não são segredo): Mensal R$ 15,99 e Anual R$ 156
  "vars": {"PROMO_ADMIN_EMAIL":"guitorniero@outlook.com","STRIPE_PRECO_MENSAL_ID":"price_1UXtp0134hMOoEZV4zpJZiw6","STRIPE_PRECO_ANUAL_ID":"price_1UXtqY134hMOoEZVGgIdzQ7a"},
  // COBRANCA fica no painel; um deploy nao deve sobrescrever a escolha de modo.
  // mantém variáveis criadas no painel
  "keep_vars": true,
  "observability": { "enabled": true }
}
